# FilePilot AI — Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is in .gitignore.

# ── Amazon Bedrock ────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ── AWS Credentials (use IAM Role on Lambda instead when possible) ──
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ── Groq fallback (optional — used if Bedrock is unavailable) ──
GROQ_API_KEY=your_groq_api_key_here
