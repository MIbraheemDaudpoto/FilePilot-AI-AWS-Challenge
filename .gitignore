# =============================================================
# FilePilot AI — .gitignore
# =============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/

# ── Lambda deployment package (generated, not committed) ─────
backend/package/
backend/lambda.zip

# ── Environment / Secrets — NEVER commit these ───────────────
.env
backend/.env
frontend/.env

# ── Node / npm ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vite build output ─────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log

# ── Junk files (from accidental pip installs inside frontend) ─
frontend/-r
frontend/cd
frontend/pip
frontend/python
frontend/uvicorn
frontend/0*
frontend/1*
frontend/2*
frontend/3*