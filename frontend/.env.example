# ── API Gateway URL (set this after deploying backend to AWS Lambda) ──
# Replace with your actual Amazon API Gateway invoke URL
VITE_API_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com
